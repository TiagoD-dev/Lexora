{
  "expo": {
    "name": "Lexora",
    "slug": "lexora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lexora-icon.png",
    "scheme": "lexora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/lexora-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12372A",
        "foregroundImage": "./assets/images/lexora-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lexora-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12372A",
          "image": "./assets/images/lexora-adaptive.png",
          "imageWidth": 112
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
