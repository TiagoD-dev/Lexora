EXPO_PUBLIC_API_URL=http://localhost:8000
LEXORA_ENV=development
LEXORA_JWT_SECRET=substituir-por-um-segredo-longo-e-aleatorio
# Base de dados (vazio = SQLite em services/api/lexora.db). Produção: postgresql+psycopg://utilizador:password@host:5432/lexora
# DATABASE_URL=
# Pasta dos documentos carregados e índice de legislação (vazio = dentro de services/api). Produção: volume persistente.
# LEXORA_STORAGE_DIR=/data/documents_storage
# LEXORA_LEGAL_INDEX=/data/legal_index.db
# Chave da API Gemini, usada pelo assistente jurídico (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Envio de emails de alerta de atraso (Gmail: usar uma App Password, não a password da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Faturação Stripe (deixar vazio até haver conta/chaves — o checkout devolve 501 até lá)
LEXORA_FRONTEND_URL=http://localhost:8081
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_OFFICE_MONTHLY=
STRIPE_PRICE_OFFICE_ANNUAL=

# Portal: URL pública da página /portal, usada nos convites (opcional na Web).
# EXPO_PUBLIC_PORTAL_URL=https://app.exemplo.pt/portal
# Origens Web autorizadas na API, separadas por vírgulas.
# LEXORA_CORS_ORIGINS=https://app.exemplo.pt
